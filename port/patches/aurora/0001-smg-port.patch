+size_t aurora_dvd_get_open_files(AuroraDvdOpenFile* files, size_t capacity) {
+  std::lock_guard lk{s_fileHandleMutex};
+  size_t count = 0;
+  for (const auto& [block, handle] : s_fileHandles) {
+    if (files != nullptr && count < capacity) {
+      files[count] = {block, handle->entrynum};
+    }
+    ++count;
+  }
+  return count;
+}
