+/*
+ * Frame interpolation
+ *
+ * Renders an extra frame halfway between two game frames. While enabled, each
+ * frame's matrices (position, normal, texture, projection) are blended halfway
+ * toward the matching matrices of the previous frame, and the frame's commands
+ * are kept so that GXAuroraInterpReplay() can render the exact frame after it:
+ *
+ *   ...game draws frame N...
+ *   aurora_end_frame();        // presents the in-between frame
+ *   aurora_begin_frame();
+ *   GXAuroraInterpReplay();    // re-renders frame N unblended
+ *   aurora_end_frame();        // presents frame N
+ *
+ * Matrices are matched between frames by the tag current when they are loaded
+ * (see GXAuroraInterpTag), so tag each object part whose matrices can change
+ * position in the command stream from frame to frame.
+ */
+void GXAuroraInterpSetEnabled(GXBool enabled);
+
+/**
+ * Identifies the matrices loaded until the next tag (e.g. the address of the
+ * object being drawn); 0 means none. Tags are cheap and may repeat within a
+ * frame. No-op while interpolation is disabled.
+ */
+void GXAuroraInterpTag(u64 tag);
+
+/**
+ * Queues the commands of the last frame for rendering, unblended, into the
+ * frame just begun. Returns GX_FALSE if there is nothing to replay.
+ */
+GXBool GXAuroraInterpReplay(void);
