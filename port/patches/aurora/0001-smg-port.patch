+// Arrays set with size 0 have an unknown extent (e.g. the Wii-style 3-argument
+// GXSetArray). For those, the bytes needed are derived from the highest index
+// each draw references; sNeededSize holds the result for the current draw.
+static std::array<u32, GX_VA_MAX_ATTR> sNeededSize{};
+
+static bool scan_unknown_array_sizes(GXVtxFmt fmt, std::span<const u8> data, u16 vtxCount, u32 vtxSize) noexcept {
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  bool needsUpload = false;
+  u32 offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const auto desc = g_gxState.vtxDesc[i];
+    if (desc == GX_NONE) {
+      continue;
+    }
+    if (desc == GX_DIRECT) {
+      const auto attr = static_cast<GXAttr>(i);
+      offset += comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+      continue;
+    }
+    const bool idx16 = desc == GX_INDEX16;
+    const u32 numIdx = i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3 ? 3 : 1;
+    const u32 idxBytes = (idx16 ? 2 : 1) * numIdx;
+    if (i >= GX_VA_POS) {
+      auto& array = g_gxState.arrays[i];
+      sNeededSize[i] = 0;
+      if (array.size == 0 && array.data != nullptr) {
+        u32 maxIdx = 0;
+        for (u32 v = 0; v < vtxCount; ++v) {
+          const u8* p = data.data() + v * vtxSize + offset;
+          for (u32 k = 0; k < numIdx; ++k) {
+            // Vertex data in the FIFO is big-endian.
+            const u32 idx = idx16 ? (u32(p[k * 2]) << 8 | p[k * 2 + 1]) : p[k];
+            if (idx > maxIdx && (idx16 ? idx != 0xFFFF : idx != 0xFF)) {
+              maxIdx = idx;
+            }
+          }
+        }
+        const u32 needed = (maxIdx + 1) * array.stride;
+        sNeededSize[i] = needed;
+        if (array.cachedRange.size == 0 || needed > array.uploadedSize) {
+          needsUpload = true;
+        }
+      }
+    }
