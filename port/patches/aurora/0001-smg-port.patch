+void setFileHandle(const DVDCommandBlock* block, CommandDataBase* handle) {
+  CommandDataBase* old = nullptr;
+  {
+    std::lock_guard lk{s_fileHandleMutex};
+    auto& slot = s_fileHandles[block];
