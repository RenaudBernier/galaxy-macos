diff --git a/lib/gx/interp.cpp b/lib/gx/interp.cpp
new file mode 100644
index 0000000..13cb8dd
--- /dev/null
+++ b/lib/gx/interp.cpp
@@ -0,0 +1,316 @@
+#include "interp.hpp"
+
+#include "fifo.hpp"
+#include "gx.hpp"
+
+#include <absl/container/flat_hash_map.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace aurora::gx::interp {
+namespace {
+enum class Mode : u8 {
+  Off,    // not interpolating, or between frames
+  Live,   // game frame being processed: record, blend and capture
+  Replay, // replaying the last live frame unblended
+};
+
+enum class Kind : u8 {
+  None,
+  Pos,  // 3x4 position matrix
+  Nrm,  // 3x3 normal matrix
+  Tex,  // 2x4/3x4 texture matrix (regular or post-transform)
+  Proj, // projection parameters
+};
+
+struct Entry {
+  u8 len = 0;
+  std::array<f32, 12> v{};
+};
+using MatrixLog = absl::flat_hash_map<u64, Entry>;
+
+constexpr f32 kBlend = 0.5f;
+
+std::atomic<bool> sEnabled{false};
+Mode sMode = Mode::Off;
+
+std::vector<u8> sCapture;     // commands of the live frame so far
+std::vector<u8> sLastCapture; // commands of the last complete live frame
+GXState sSnapshot;            // processor state at the start of the live frame
+GXState sLastSnapshot;
+bool sHaveLast = false;
+
+MatrixLog sPrevLog; // matrices of the previous live frame
+MatrixLog sCurLog;  // matrices of the live frame so far
+bool sHavePrev = false;
+
+u64 sTag = 0;
+u32 sTagOccurrence = 0;
+u32 sTagIndex = 0;
+std::array<u32, 0x600> sUntaggedCounts{}; // per XF address
+absl::flat_hash_map<u64, u32> sTagCounts;
+
+u64 combine(u64 h, u64 v) noexcept {
+  h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+  h *= 0xBF58476D1CE4E5B9ull;
+  return h ^ (h >> 31);
+}
+
+u64 next_key(u32 addr) noexcept {
+  if (sTag != 0) {
+    return combine(combine(combine(combine(1, sTag), sTagOccurrence), sTagIndex++), addr);
+  }
+  // Numbered per destination, so e.g. the projections stay matched when the
+  // number of other untagged matrices changes.
+  const u32 slot = addr < sUntaggedCounts.size() ? addr : sUntaggedCounts.size() - 1;
+  return combine(combine(2, sUntaggedCounts[slot]++), addr);
+}
+
+Kind classify(u32 addr, u32 len) noexcept {
+  if (addr < 0x078) {
+    return len == 12 ? Kind::Pos : Kind::None;
+  }
+  if (addr < 0x0F0) {
+    return len == 8 || len == 12 ? Kind::Tex : Kind::None;
+  }
+  if (addr >= 0x400 && addr < 0x45A) {
+    return len == 9 ? Kind::Nrm : Kind::None;
+  }
+  if (addr >= 0x500 && addr < 0x5F0) {
+    return len == 12 ? Kind::Tex : Kind::None;
+  }
+  return Kind::None;
+}
+
+f32 lerp(f32 a, f32 b) noexcept { return a + (b - a) * kBlend; }
+
+// Blends a 3x3 basis (rows of `stride` floats) and keeps each column's length
+// at the blended length, so rotations do not shrink.
+bool blend_basis(const f32* a, const f32* b, f32* out, u32 stride) noexcept {
+  f32 diff = 0.f;
+  f32 norm = 0.f;
+  for (u32 r = 0; r < 3; ++r) {
+    for (u32 c = 0; c < 3; ++c) {
+      const f32 d = b[r * stride + c] - a[r * stride + c];
+      diff += d * d;
+      norm += b[r * stride + c] * b[r * stride + c];
+    }
+  }
+  // Too different to be the same object a frame apart (about 35 degrees).
+  if (diff > 0.36f * norm) {
+    return false;
+  }
+  for (u32 c = 0; c < 3; ++c) {
+    f32 la = 0.f;
+    f32 lb = 0.f;
+    f32 lo = 0.f;
+    for (u32 r = 0; r < 3; ++r) {
+      const f32 va = a[r * stride + c];
+      const f32 vb = b[r * stride + c];
+      const f32 vo = lerp(va, vb);
+      out[r * stride + c] = vo;
+      la += va * va;
+      lb += vb * vb;
+      lo += vo * vo;
+    }
+    if (lo > 1e-12f) {
+      const f32 scale = lerp(std::sqrt(la), std::sqrt(lb)) / std::sqrt(lo);
+      for (u32 r = 0; r < 3; ++r) {
+        out[r * stride + c] *= scale;
+      }
+    }
+  }
+  return true;
+}
+
+bool blend(Kind kind, const f32* a, const f32* b, u32 len, f32* out) noexcept {
+  switch (kind) {
+  case Kind::Pos: {
+    const f32 ta[3] = {a[3], a[7], a[11]};
+    const f32 tb[3] = {b[3], b[7], b[11]};
+    f32 dt = 0.f;
+    f32 la = 0.f;
+    f32 lb = 0.f;
+    for (int i = 0; i < 3; ++i) {
+      dt += (tb[i] - ta[i]) * (tb[i] - ta[i]);
+      la += ta[i] * ta[i];
+      lb += tb[i] * tb[i];
+    }
+    // A jump (camera cut, teleport) rather than motion.
+    const f32 limit = 0.5f * std::sqrt(std::max(la, lb)) + 300.f;
+    if (dt > limit * limit) {
+      return false;
+    }
+    if (!blend_basis(a, b, out, 4)) {
+      return false;
+    }
+    for (int r = 0; r < 3; ++r) {
+      out[r * 4 + 3] = lerp(a[r * 4 + 3], b[r * 4 + 3]);
+    }
+    return true;
+  }
+  case Kind::Nrm:
+    return blend_basis(a, b, out, 3);
+  case Kind::Tex:
+    for (u32 i = 0; i < len; ++i) {
+      // Scrolling textures wrap around; do not blend across a wrap.
+      if (std::abs(b[i] - a[i]) > 0.5f * std::max({1.f, std::abs(a[i]), std::abs(b[i])})) {
+        return false;
+      }
+    }
+    for (u32 i = 0; i < len; ++i) {
+      out[i] = lerp(a[i], b[i]);
+    }
+    return true;
+  case Kind::Proj:
+    if (std::bit_cast<u32>(a[6]) != std::bit_cast<u32>(b[6])) {
+      return false; // projection type changed
+    }
+    for (u32 i = 0; i < 6; ++i) {
+      if (std::abs(b[i] - a[i]) > 0.25f * std::max(std::abs(a[i]), std::abs(b[i]))) {
+        return false;
+      }
+    }
+    for (u32 i = 0; i < 6; ++i) {
+      out[i] = lerp(a[i], b[i]);
+    }
+    out[6] = b[6];
+    return true;
+  default:
+    return false;
+  }
+}
+
+void write_f32(u8* dst, f32 value, std::endian e) noexcept {
+  u32 bits = std::bit_cast<u32>(value);
+  if (e != std::endian::native) {
+    bits = bswap(bits);
+  }
+  std::memcpy(dst, &bits, sizeof(bits));
+}
+
+// Records `cur` and, when the previous frame has the same matrix, writes the
+// blended values to `out`. Returns whether `out` was written.
+bool record_and_blend(Kind kind, u32 addr, const Entry& cur, f32* out) noexcept {
+  const u64 key = next_key(addr);
+  sCurLog.insert_or_assign(key, cur);
+  if (!sHavePrev) {
+    return false;
+  }
+  const auto it = sPrevLog.find(key);
+  if (it == sPrevLog.end() || it->second.len != cur.len) {
+    return false;
+  }
+  if (!blend(kind, it->second.v.data(), cur.v.data(), cur.len, out)) {
+    return false;
+  }
+  return true;
+}
+} // namespace
+
+void set_enabled(bool enabled) noexcept { sEnabled.store(enabled, std::memory_order_release); }
+
+bool enabled() noexcept { return sEnabled.load(std::memory_order_acquire); }
+
+void begin_frame() noexcept {
+  if (!enabled()) {
+    sMode = Mode::Off;
+    sHavePrev = false;
+    sHaveLast = false;
+    return;
+  }
+  sMode = Mode::Live;
+  sSnapshot = g_gxState;
+  sCapture.clear();
+  sCurLog.clear();
+  sTag = 0;
+  sTagOccurrence = 0;
+  sTagIndex = 0;
+  sUntaggedCounts.fill(0);
+  sTagCounts.clear();
+}
+
+void end_frame() noexcept {
+  if (sMode == Mode::Live) {
+    std::swap(sLastCapture, sCapture);
+    std::swap(sLastSnapshot, sSnapshot);
+    std::swap(sPrevLog, sCurLog);
+    sHaveLast = true;
+    sHavePrev = true;
+  }
+  sMode = Mode::Off;
+}
+
+bool replay() noexcept {
+  if (!enabled() || !sHaveLast) {
+    return false;
+  }
+  sMode = Mode::Replay;
+  g_gxState = sLastSnapshot;
+  g_gxState.dirty = DirtyAll;
+  fifo::write_data(sLastCapture.data(), static_cast<u32>(sLastCapture.size()));
+  fifo::publish();
+  return true;
+}
+
+bool capturing() noexcept { return sMode == Mode::Live; }
+
+bool replaying() noexcept { return sMode == Mode::Replay; }
+
+void capture(const u8* data, u32 size) noexcept { sCapture.insert(sCapture.end(), data, data + size); }
+
+void set_tag(u64 tag) noexcept {
+  if (sMode != Mode::Live) {
+    return;
+  }
+  sTag = tag;
+  sTagIndex = 0;
+  sTagOccurrence = tag != 0 ? ++sTagCounts[tag] : 0;
+}
+
+const u8* filter_matrix(u32 addr, const u8* data, u32 len, std::endian e, u8* scratch) noexcept {
+  if (sMode != Mode::Live) {
+    return data;
+  }
+  const Kind kind = classify(addr, len);
+  if (kind == Kind::None) {
+    return data;
+  }
+  Entry cur{.len = static_cast<u8>(len)};
+  for (u32 i = 0; i < len; ++i) {
+    cur.v[i] = read_bits<f32>(data + i * 4, e);
+  }
+  std::array<f32, 12> out;
+  if (!record_and_blend(kind, addr, cur, out.data())) {
+    return data;
+  }
+  for (u32 i = 0; i < len; ++i) {
+    write_f32(scratch + i * 4, out[i], e);
+  }
+  return scratch;
+}
+
+const u8* filter_projection(const u8* data, u8* scratch) noexcept {
+  if (sMode != Mode::Live) {
+    return data;
+  }
+  Entry cur{.len = 7};
+  for (u32 i = 0; i < 7; ++i) {
+    cur.v[i] = read_bits<f32>(data + i * 4);
+  }
+  std::array<f32, 12> out;
+  if (!record_and_blend(Kind::Proj, 0x1020, cur, out.data())) {
+    return data;
+  }
+  for (u32 i = 0; i < 7; ++i) {
+    write_f32(scratch + i * 4, out[i], std::endian::big);
+  }
+  return scratch;
+}
+
+} // namespace aurora::gx::interp
