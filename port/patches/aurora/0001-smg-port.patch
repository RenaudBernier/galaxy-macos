+void aurora_dvd_set_open_files(const AuroraDvdOpenFile* files, size_t count) {
+  std::vector<CommandDataBase*> closed;
+  {
+    std::lock_guard lk{s_fileHandleMutex};
+    for (const auto& [block, handle] : s_fileHandles) {
+      closed.push_back(handle);
+    }
+    s_fileHandles.clear();
+  }
+  for (CommandDataBase* handle : closed) {
+    delete handle;
+  }
+  std::lock_guard lock(s_fstLock);
+  for (size_t i = 0; i < count; ++i) {
+    if (!isValidEntryNum(files[i].entrynum)) {
+      continue;
+    }
+    if (CommandDataBase* data = openEntryLocked(files[i].entrynum)) {
+      setFileHandle(static_cast<const DVDCommandBlock*>(files[i].block), data);
+    }
+  }
