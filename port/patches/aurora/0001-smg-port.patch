+#pragma once
+
+#include "../internal.hpp"
+
+#include <dolphin/types.h>
+
+#include <bit>
+#include <cstdint>
+
+// Frame interpolation: renders an extra frame between two game frames.
+//
+// While a game frame is processed ("live"), every matrix written to XF memory
+// (position, normal, texture matrices and the projection) is recorded under a
+// key that identifies it across frames, and the value actually used for
+// rendering is blended halfway toward the matching matrix of the previous
+// frame. The live frame therefore shows the moment between the two game
+// frames. The frame's command stream is captured as it is processed; replaying
+// it afterwards (from the same starting state, without blending) renders the
+// exact game frame, which is presented next.
+//
+// Keys come from tags the game sets around its draws (GXAuroraInterpTag, e.g.
+// one per model part): a matrix is identified by the current tag, how many
+// times that tag was set so far this frame, and its position since the tag was
+// set. Matrices loaded without a tag are numbered in frame order instead.
+namespace aurora::gx::interp {
+
+void set_enabled(bool enabled) noexcept;
+bool enabled() noexcept;
+
+// FIFO frame lifecycle (game thread, FIFO idle).
+void begin_frame() noexcept;
+void end_frame() noexcept;
+// Queues the last live frame's commands for replay into the current frame.
+bool replay() noexcept;
+
+// Command processing hooks (FIFO processor thread).
+bool capturing() noexcept;
+bool replaying() noexcept;
+void capture(const u8* data, u32 size) noexcept;
+void set_tag(u64 tag) noexcept;
+// Records a matrix write and returns the data to use (possibly a blended copy
+// in `scratch`, in the same byte order). `addr` is the XF memory address.
+const u8* filter_matrix(u32 addr, const u8* data, u32 len, std::endian e, u8* scratch) noexcept;
+// Same for the projection block (XF registers 0x1020-0x1026, 7 big-endian words).
+const u8* filter_projection(const u8* data, u8* scratch) noexcept;
+
+} // namespace aurora::gx::interp
